# EdgeRemit environment
# Copy to .env and fill in. Never commit real keys.

# DEMO_MODE=1 → keyword/heuristic OpenVINO path (default when LIVE_OPENVINO is off)
# DEMO_MODE=0 + LIVE_OPENVINO=1 → real OpenVINO Runtime intent router on CPU
DEMO_MODE=1
LIVE_OPENVINO=0

# Optional: Speechmatics STT bonus stub (demo does not block if missing)
# https://www.speechmatics.com/
SPEECHMATICS_API_KEY=

# Optional unused: reserved for future LLM prose polish
# OPENAI_API_KEY=
